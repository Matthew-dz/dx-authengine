# ==========================================
# DX-AuthEngine - Cấu hình Môi trường Mẫu (.env.example)
# Giữ lại toàn bộ tên biến (keys), toàn bộ giá trị (values) được làm rỗng để an toàn khi đẩy lên GitHub
# ==========================================

GEMINI_API_KEY=
DATABASE_URL=

# SMTP Email Config
SMTP_SERVER=
SMTP_PORT=
SENDER_EMAIL=
SENDER_PASSWORD=

# JWT Authentication Config
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# CORS Config
FRONTEND_CORS_ORIGINS=
