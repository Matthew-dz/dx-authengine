# ==========================================
# DX-AuthEngine - Cấu hình Môi trường (Example)
# ==========================================

# --- BẢO MẬT XÁC THỰC (JWT) ---
# Sinh khóa bí mật ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CƠ SỞ DỮ LIỆU ---
# Dùng SQLite cho môi trường Local Dev: sqlite:///./dx_os.db
# Dùng PostgreSQL cho môi trường Production:
DATABASE_URL=postgresql://username:password@localhost:5432/dx_ecommerce

# --- TÍCH HỢP TRÍ TUỆ NHÂN TẠO (AI) ---
# Lấy key tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- CẤU HÌNH GỬI EMAIL (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here

# --- BẢO MẬT CORS ---
FRONTEND_CORS_ORIGINS="http://127.0.0.1:5500,http://localhost:5500"
